# Copy this file to .env and fill in real values.
# Never commit .env itself.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database. Defaults to local SQLite if unset.
# For PostgreSQL in production, use e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/redgum
DATABASE_URL=

# Timetable window (24h format)
TIMETABLE_START_HOUR=9
TIMETABLE_END_HOUR=20
